@startuml DS-06-pesquisa-global
title Pesquisa global
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Utilizador

boundary "UI" as UI
control "Controller" as C
control "Service" as S
control "Repository" as R
database "BD" as BD

Utilizador -> UI : 1. introduz termo e Pesquisar
UI -> C : 2. onPesquisar() / handleSubmit()

C -> S : 3. pesquisar_global(termo)
S -> S : 4. validar termo não vazio

alt termo vazio
  S --> C : 400
  C --> UI : erro
else ok
  S -> R : 5. searchComputadores()
  R -> BD : 6. SELECT computadores
  BD --> R : lista
  R --> S : computadores

  S -> R : 7. searchInventarios()
  R -> BD : 8. SELECT inventarios
  BD --> R : lista
  R --> S : inventarios

  S -> R : 9. searchUtilizadores()
  R -> BD : 10. SELECT utilizadores
  BD --> R : lista
  R --> S : utilizadores

  S -> R : 11. searchLocalizacoes()
  R -> BD : 12. SELECT localizacoes
  BD --> R : lista
  R --> S : localizacoes

  S --> C : 13. 200 PesquisaGlobalResponse
  C --> UI : 14. JSON resultados
  UI -> UI : 15. filtros e grelha
  UI --> Utilizador : 16. resultados visíveis
end

@enduml
