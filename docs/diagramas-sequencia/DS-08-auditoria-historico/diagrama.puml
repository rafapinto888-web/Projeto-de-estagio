@startuml DS-08-historico-conta
title Histórico de auditoria da conta
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Utilizador

boundary "UI" as UI
control "Controller" as C
control "Service" as S
control "Repository" as R
database "BD" as BD

== Consultar histórico ==

Utilizador -> UI : 1. abre Histórico da conta
UI -> C : 2. carregar página (token)

C -> S : 3. historico_do_utilizador()
S -> S : 4. get_current_user()

S -> R : 5. findLogsByUtilizadorId()
R -> BD : 6. SELECT logs_sistema\nORDER BY data_evento
BD --> R : registos
R --> S : lista
S --> C : 7. 200 HistoricoUtilizadorLista
C --> UI : 8. itens na lista
UI --> Utilizador : 9. vê acções passadas

== Registar evento (após operação) ==

Utilizador -> UI : 10. operação concluída (ex. criar PC)
UI -> C : 11. withAction() sucesso

C -> S : 12. registar_evento_historico()
S -> S : 13. registar_log_sistema()

S -> R : 14. insertLogSistema()
R -> BD : 15. INSERT logs_sistema\nCOMMIT
BD --> R : ok
R --> S : ok
S --> C : 16. 201 Created

@enduml
