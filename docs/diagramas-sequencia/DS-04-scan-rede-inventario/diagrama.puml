@startuml DS-04-scan-rede
title Scan de rede (inventário sub-rede)
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Utilizador

boundary "UI" as UI
control "Controller" as C
control "Service" as S
control "Repository" as R
database "BD" as BD

Utilizador -> UI : 1. define rede e credenciais
UI -> C : 2. iniciar scan (withAction)

C -> S : 3. executar_scan_do_inventario()
S -> S : 4. require_admin()\nobter_inventario_ou_404()\nvalidar tipo sub_rede

S -> S : 5. descobrir_dispositivos_enriquecidos()

S -> R : 6. findDispositivosByIPs()
R -> BD : 7. SELECT dispositivos_descobertos

loop cada IP activo
  alt IP novo
    S -> R : 8. insertDispositivo()
    R -> BD : INSERT
  else IP existente
    S -> R : 8. updateDispositivo()
    R -> BD : UPDATE estado=ativo
  end
end

S -> R : 9. markInativos(ips_nao_vistos)
R -> BD : UPDATE estado=inativo

R -> BD : 10. COMMIT
BD --> R : ok
R --> S : ok
S --> C : 11. 200 ScanRedeResponse

C -> C : 12. loadAllData()\nrefreshAtivos()
C --> UI : 13. resultado scan
UI --> Utilizador : 14. lista actualizada

@enduml
