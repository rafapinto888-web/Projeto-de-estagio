@startuml DS-05-criar-computador
title Registar computador
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Utilizador

boundary "UI" as UI
control "Controller" as C
control "Service" as S
control "Repository" as R
database "BD" as BD

Utilizador -> UI : 1. preenche dados do PC
UI -> C : 2. withAction(criar)

C -> S : 3. adicionar_computador()
S -> S : 4. require_admin()\nvalidar_inventario()\nvalidar_localizacao()\nvalidar_utilizador_responsavel()

S -> R : 5. findByNumeroSerie(serie)
R -> BD : 6. SELECT computadores
BD --> R : null | existente
R --> S : resultado

alt série duplicada
  S --> C : 400
  C --> UI : erro
else ok
  S -> R : 7. criar_computador_db()
  R -> BD : 8. INSERT computadores\nCOMMIT
  BD --> R : computador
  R --> S : ComputadorDB
  S --> C : 9. 201 Created
  C -> C : 10. loadAllData()
  C --> UI : 11. lista actualizada
  UI --> Utilizador : 12. computador registado
end

@enduml
