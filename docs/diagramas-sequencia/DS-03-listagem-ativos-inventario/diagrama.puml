@startuml DS-03-listagem-ativos
title Listar ativos do inventário
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Utilizador

boundary "UI" as UI
control "Controller" as C
control "Service" as S
control "Repository" as R
database "BD" as BD

Utilizador -> UI : 1. selecciona inventário
UI -> C : 2. refreshAtivos(inventarioId)

alt com termo de pesquisa
  C -> S : 3. pesquisar_computadores_do_inventario()
  S -> S : 4. _garantir_acesso_inventario()
  S -> R : 5. searchAtivos(termo)
  R -> BD : 6. SELECT computadores\ndispositivos_descobertos
else sem termo
  C -> S : 3. listar_computadores_do_inventario()
  S -> S : 4. _garantir_acesso_inventario()
  S -> R : 5. findAtivosByInventario()
  R -> BD : 6. SELECT computadores\ndispositivos_descobertos
end

BD --> R : registos
R --> S : lista unificada
S --> C : 7. 200 JSON
C -> C : 8. setAtivos(dados)
C --> UI : 9. dados na grelha
UI --> Utilizador : 10. vê PCs e dispositivos scan

@enduml
