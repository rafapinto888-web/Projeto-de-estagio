@startuml DS-07-consulta-logs
title Consultar logs de dispositivo
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor Utilizador

boundary "UI" as UI
control "Controller" as C
control "Service" as S
control "Repository" as R
database "BD" as BD

Utilizador -> UI : 1. define filtros (PC / tipo log)
UI -> C : 2. onLogsComputador()

C -> S : 3. consultar_logs_dispositivo()
S -> S : 4. get_current_user()

S -> R : 5. resolveComputador(\nid | nome | serie | hostname)
R -> BD : 6. SELECT computadores
BD --> R : computador
R --> S : computador

S -> R : 7. findLogsByComputador(tipo_log)
R -> BD : 8. SELECT logs_dispositivo
BD --> R : eventos
R --> S : lista logs

S --> C : 9. 200 LogsDispositivoConsultaResponse
C -> C : 10. setLogsOutput()
C --> UI : 11. texto / tabela logs
UI --> Utilizador : 12. vê eventos segurança/RDP

@enduml
