@startuml
title Diagrama de Sequencia - Criar ou editar computador

actor Administrador as U
participant Frontend as FE
participant API as API
database "Base de Dados" as BD
participant "Sistema de Logs" as LOG

U -> FE : Preenche formulario do computador

FE -> API : Enviar dados

API -> BD : Validar inventario e relacoes
BD --> API : Dados validos

API -> BD : Guardar computador
BD --> API : Confirmacao

API --> FE : Operacao concluida

FE -> API : Pedir listas atualizadas
API -> BD : Carregar dados do painel
BD --> API : Dados
API --> FE : Painel atualizado

alt Operacao com sucesso
  FE -> API : Registar acao no historico
  API -> LOG : Guardar auditoria
  LOG --> API : Confirmacao
  FE --> U : Mostrar sucesso
else Erro na operacao
  API --> FE : Erro
  FE --> U : Mostrar erro
end

@enduml
