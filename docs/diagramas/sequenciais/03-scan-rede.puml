@startuml
title Diagrama de Sequencia - Scan de rede

actor Administrador as U
participant Frontend as FE
participant API as API
database "Base de Dados" as BD
participant "Maquinas na rede" as REDE

U -> FE : Escolhe inventario, rede e credenciais

FE -> FE : Validar formulario

FE -> API : Pedir scan da rede

API -> BD : Confirmar inventario de sub-rede
BD --> API : Inventario valido

API -> REDE : Descobrir equipamentos ativos
REDE --> API : Lista de dispositivos

loop Cada equipamento encontrado
  API -> BD : Guardar ou atualizar dispositivo
  opt Equipamento com computador associado
    API -> REDE : Recolher logs Windows
    REDE --> API : Eventos
    API -> BD : Guardar logs
  end
end

API -> BD : Marcar inativos os ausentes no scan
BD --> API : Confirmacao

API --> FE : Resumo do scan

FE -> FE : Atualizar painel

FE --> U : Mostrar resultado

@enduml
