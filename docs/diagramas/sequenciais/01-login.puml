@startuml
title Diagrama de Sequencia - Login

actor Utilizador as U
participant Frontend as FE
participant API as API
database "Base de Dados" as BD
participant "Sistema de Logs" as LOG

U -> FE : Introduz email e password
FE -> API : Envia credenciais

API -> BD : Procurar utilizador
BD --> API : Dados do utilizador

API -> API : Validar credenciais

alt Credenciais validas
  API -> LOG : Registar tentativa de login
  LOG --> API : Confirmacao
  API --> FE : Login com sucesso
  FE -> FE : Guardar sessao
  FE -> API : Pedir perfil e dados do painel
  API -> BD : Carregar listas iniciais
  BD --> API : Dados
  API --> FE : Informacao do utilizador
  FE --> U : Mostrar acesso ao sistema
else Credenciais invalidas
  API --> FE : Erro de autenticacao
  FE --> U : Mostrar erro
end

@enduml
