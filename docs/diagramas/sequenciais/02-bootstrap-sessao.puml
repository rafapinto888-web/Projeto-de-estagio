@startuml
title Diagrama de Sequencia - Arranque da aplicacao

actor Utilizador as U
participant Frontend as FE
participant API as API
database "Base de Dados" as BD

U -> FE : Abre ou atualiza a pagina

FE -> FE : Verificar sessao guardada

alt Sem sessao
  FE --> U : Mostrar ecra de login
else Com sessao guardada
  FE -> API : Confirmar sessao
  API -> BD : Carregar utilizador
  BD --> API : Dados do utilizador
  API -> API : Validar sessao
  alt Sessao valida
    API --> FE : Sessao aceite
    FE -> API : Pedir dados do painel
    API -> BD : Carregar inventarios e listas
    BD --> API : Dados
    API --> FE : Informacao atualizada
    FE --> U : Mostrar ultima pagina ou Dashboard
  else Sessao invalida
    API --> FE : Sessao recusada
    FE -> FE : Apagar sessao local
    FE --> U : Mostrar ecra de login
  end
end

@enduml
